# ===========================================
# 本地 Supabase 密钥 —— worktree-manager.sh 生成 .env 时读取
# ===========================================
# 用法:
#   cp .worktree-secrets.env.example .worktree-secrets.env
#   然后填入 `supabase status` 输出的本地密钥
#
# 本文件(.example)可以进 git;.worktree-secrets.env 已被 .gitignore 忽略,
# 绝不要把真实密钥写进任何被跟踪的文件(脚本 / compose / CI 配置)。

# 本地 Docker Supabase (http://127.0.0.1:54321) 的密钥
LOCAL_SUPABASE_ANON_KEY=sb_publishable_replace_me
LOCAL_SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me
