# ===========================================
# 后端环境变量配置
# 复制此文件为 .env 并填入实际值
# ===========================================

# Supabase 配置（必需）
# 从 Supabase Dashboard -> Settings -> API 获取
#
# Supabase 提供两种密钥格式：
# - Publishable key (sb_publishable_...) - 前端公开使用
# - Secret key (sb_secret_...) - 后端私密使用
# - Legacy keys (JWT 格式) - 旧版本，仍然兼容
#
SUPABASE_URL=https://your-project.supabase.co

# Publishable Key（公开密钥）- 可以是新格式或旧版 anon key
SUPABASE_ANON_KEY=sb_publishable_xxx 或 eyJhbGciOiJIUzI1NiIs...

# Secret Key（私密密钥）- 可以是新格式或旧版 service_role key
# 注意：此密钥具有完全访问权限，绝不能暴露在前端！
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx 或 eyJhbGciOiJIUzI1NiIs...

# ===========================================
# 服务器配置
# ===========================================
HOST=0.0.0.0
APP_PORT=8080
RELOAD=true

# ===========================================
# 下载配置
# ===========================================
DOWNLOAD_PATH=/volume2/sources/MediaHub.library

# ===========================================
# Notion 集成（可选）
# ===========================================
PUSH_TO_NOTION=false
NOTION_API_KEY=
NOTION_DATABASE_ID=

# ===========================================
# OpenAI Configuration
# ===========================================
# DB-ONLY (2026-07-07 铁律): OPENAI_API_KEY / OPENAI_MODEL are retired.
# Configure models in Admin -> AI Models or Settings -> AI Providers.

# ===========================================
# LLM Configuration (Script / Storyboard AI Agent framework)
# ===========================================
# LLM credentials are DB-ONLY (2026-07-07 铁律): configure platform models in
# Admin -> AI Models (mediahub_models catalog) or per-user keys in
# Settings -> AI Providers. LLM_API_URL / LLM_API_KEY / LLM_MODEL are retired.
# Request timeout in seconds for a single LLM call.
LLM_TIMEOUT_SECONDS=120
# Token budget for AI agent context window (leaves headroom for response).
LLM_MAX_CONTEXT_TOKENS=28000
# Maximum prior messages loaded before applying the token budget.
LLM_MAX_HISTORY_MESSAGES=50
# Cache TTL for agent config lookups (seconds).
LLM_AGENT_CACHE_TTL_SECONDS=300
