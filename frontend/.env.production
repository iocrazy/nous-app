# ===========================================
# 生产环境配置
# ===========================================

# gpupc 自托管 Supabase (Kong API Gateway)，经 nas-A 反代 → ZeroTier
VITE_SUPABASE_URL=https://cn-sb.nous.ink:88
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzU1MzYwMDAwLCJleHAiOjE5MTMxMjY0MDB9.wPhnjPuLiTrDMGiUpSyS68ns-8kP6Zt86CDiE_QGvVo

# 后端 API 地址 — 必须是绝对地址。
# 托管在 Cloudflare Pages 上没有 Vercel 那种 rewrite，留空会让 /api/* 被
# public/_redirects 的 SPA fallback 吞掉、返回 index.html。
VITE_API_URL=https://cn.nous.ink:88

# ===========================================
# 生产 feature flags
# ===========================================
# 这些是 build-time flag（`import.meta.env.VITE_FEATURE_*`，静态读取），
# 与 admin → Module Control Center 的 DB 开关是两套东西，别混。
#
# 必须与 .github/workflows/deploy-pages.yml 的构建 env 一致。CI 构建时 GHA
# 的环境变量优先级高于本文件（Vite: 已存在的环境变量不被 .env 覆盖），所以
# 线上以 workflow 为准；本文件保证**本地 `npm run build` + wrangler 直传**
# 这条应急路径产出的包和 CI 一致。
# 漂移的后果实测过：2026-07-23 首次 Pages 构建漏了全部 flag，灵感库直接
# 退回老版、画布导航/协作全缺。
#
# ⚠️ 只列真正被代码读取的 flag。仓库里另有 VITE_FEATURE_CONVERSATIONS /
# PROJECT_WORKBENCH / PROJECT_AI_SUGGEST / PROJECT_WORKSPACE_V2 的历史痕迹，
# 但对应功能已毕业、运行时读取已删除，设了也没有任何效果。
VITE_FEATURE_INSPIRATION_NOTES=true
VITE_FEATURE_CANVAS_NAV=true
VITE_FEATURE_COLLAB=true

# flag-dark（未上线，故意不开）：
#   VITE_FEATURE_SHOT_VIDEO   — storyboard 视频生成面，见 StoryboardView.tsx
#   VITE_FEATURE_SCRIPT_TIPTAP — 仅测试里 vi.stubEnv，无运行时读取
