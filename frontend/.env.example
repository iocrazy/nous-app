# ===========================================
# 前端环境变量配置
# 复制此文件为 .env 并填入实际值
# ===========================================

# Supabase 配置（必需）
# 从 Supabase Dashboard -> Settings -> API 获取
#
# 前端只需要 Publishable Key（公开密钥）
# 这个密钥设计上可以安全地暴露在前端代码中
# Supabase 通过 RLS（行级安全策略）保护数据访问
#
VITE_SUPABASE_URL=https://your-project.supabase.co

# Publishable Key - 可以是新格式或旧版 anon key
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx 或 eyJhbGciOiJIUzI1NiIs...

# 后端 API 地址（用于抖音视频解析等后端功能）
VITE_API_URL=http://localhost:8080
