# ===========================================
# MediaHub Docker Environment Configuration
# Copy this file to .env and fill in actual values
# ===========================================

# Supabase Configuration (Required)
# Get from Supabase Dashboard -> Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# Server Configuration
# ===========================================
HOST=0.0.0.0
APP_PORT=8080

# ===========================================
# Download Configuration
# ===========================================
# Host path for downloaded videos (mounted to container)
# Default: /volume2/sources/MediaHub.library
DOWNLOAD_PATH=/volume2/sources/MediaHub.library

# Path inside container (don't change)
NAS_BASE_PATH=/app/downloads

# ===========================================
# Flower Monitoring (Optional)
# ===========================================
FLOWER_USER=admin
FLOWER_PASSWORD=your-secure-password

# ===========================================
# Notion Integration (Optional)
# ===========================================
PUSH_TO_NOTION=false
NOTION_API_KEY=
NOTION_DATABASE_ID=

# ===========================================
# OpenAI Configuration (Optional, for visual analysis)
# ===========================================
OPENAI_API_KEY=sk-your-api-key
OPENAI_MODEL=gpt-4o
