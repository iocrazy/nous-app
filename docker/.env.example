# ===========================================
# MediaHub Docker Environment Configuration
# Copy this file to .env and fill in actual values
# ===========================================

# Supabase Configuration (Required)
# Get from Supabase Dashboard -> Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# Media Storage Configuration
# ===========================================
# Host path for downloaded videos (mounted to container)
# This is where video files will be stored on your NAS/server
# Default: /volume2/sources/MediaHub.library
HOST_MEDIA_PATH=/volume2/sources/MediaHub.library

# ===========================================
# Flower Monitoring (Optional)
# ===========================================
FLOWER_USER=admin
FLOWER_PASSWORD=your-secure-password

# ===========================================
# OpenAI Configuration (Optional, for visual analysis)
# ===========================================
OPENAI_API_KEY=sk-your-api-key
OPENAI_MODEL=gpt-4o
