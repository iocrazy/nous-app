# ===========================================
# MediaHub Docker Environment Configuration
# Copy this file to .env and fill in actual values
# ===========================================

# Supabase Configuration (Required)
# Get from Supabase Dashboard -> Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# Server Configuration
# ===========================================
HOST=0.0.0.0
APP_PORT=8080

# ===========================================
# Download Configuration
# ===========================================
# Host path for video storage (NAS/host machine path)
# This path will be mounted to /app/downloads inside the container
DOWNLOAD_HOST_PATH=/volume2/sources/MediaHub.library
# Note: DOWNLOAD_PATH defaults to /app/downloads in code, no need to set here

# ===========================================
# Flower Monitoring (Optional)
# ===========================================
FLOWER_USER=admin
FLOWER_PASSWORD=your-secure-password

# ===========================================
# Notion Integration (Optional)
# ===========================================
PUSH_TO_NOTION=false
NOTION_API_KEY=
NOTION_DATABASE_ID=

# ===========================================
# AI Provider Configuration (Optional)
# ===========================================

# OpenAI - GPT models and Whisper API
OPENAI_API_KEY=sk-your-api-key
OPENAI_MODEL=gpt-4o

# DeepSeek - Cost-effective cloud AI
DEEPSEEK_API_KEY=

# Doubao (ByteDance) - Chinese language optimized
DOUBAO_API_KEY=

# ===========================================
# Whisper Transcription Configuration
# ===========================================
# Provider: "openai_api" (cloud, default) or "local" (faster-whisper)
WHISPER_PROVIDER=openai_api
