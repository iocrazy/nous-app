# ===========================================
# MediaHub Docker Environment Configuration
# Copy this file to .env and fill in actual values
# ===========================================

# Supabase Configuration (Required)
# Get from Supabase Dashboard -> Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# Server Configuration
# ===========================================
HOST=0.0.0.0
APP_PORT=8080

# ===========================================
# Download Configuration
# ===========================================
# Host path for video storage (NAS/host machine path)
# This path will be mounted to /app/downloads inside the container
DOWNLOAD_HOST_PATH=/volume2/sources/MediaHub.library
# Note: DOWNLOAD_PATH defaults to /app/downloads in code, no need to set here

# ===========================================
# Flower Monitoring (Optional)
# ===========================================
FLOWER_USER=admin
FLOWER_PASSWORD=your-secure-password

# ===========================================
# Notion Integration (Optional)
# ===========================================
PUSH_TO_NOTION=false
NOTION_API_KEY=
NOTION_DATABASE_ID=

# ===========================================
# AI Provider Configuration (Optional)
# ===========================================

# OpenAI - GPT models and Whisper API
OPENAI_API_KEY=sk-your-api-key
OPENAI_MODEL=gpt-4o

# DeepSeek - Cost-effective cloud AI
DEEPSEEK_API_KEY=

# Doubao (ByteDance) - Chinese language optimized
DOUBAO_API_KEY=

# ===========================================
# Whisper Transcription Configuration
# ===========================================
# Provider: "openai_api" (cloud, default) or "local" (faster-whisper)
WHISPER_PROVIDER=openai_api

# ===========================================
# DBOS Orchestrator (REQUIRED for media fetch / AI workflows)
# ===========================================
# Direct PostgreSQL connection for the DBOS workflow engine. DBOS uses
# LISTEN/NOTIFY which does NOT survive any pooler (supavisor /
# pgbouncer), so this MUST be the direct PG host:port — not the
# supavisor session-mode (default 55434) or transaction-mode (6543) port.
#
# For the self-hosted Supabase prod stack on NAS the direct PG host port
# is typically 55436 (mapped from container's 55434).
#
# If empty, fetch / transcribe / summary endpoints return HTTP 500 with
# "DBOS orchestrator is not enabled (DBOS_DATABASE_URL missing or init
# failed)". On first launch DBOS auto-creates the `dbos` schema with 11
# tables — give the backend ~90s start_period for that migration.
DBOS_DATABASE_URL=postgresql://postgres:CHANGE_ME@192.168.50.9:55436/postgres

# ===========================================
# SSRF Boundary Layer (optional override)
# ===========================================
# DNS resolution timeout for url_guard. Default in code is 2.0s, which
# is too tight when the host's resolver is upstream Google DNS in CN —
# CN platform domains (bilibili / douyin / xhs) intermittently exceed
# 2s and trigger spurious URLBlockedError → HTTP 400 on /media/fetch.
# 5.0s gives comfortable headroom; 2.0s is fine if the host resolver
# is already a CN DNS (223.5.5.5 / 119.29.29.29) — note the compose
# file pins those at the container level, so most deployments can leave
# this unset.
SSRF_DNS_TIMEOUT_SECONDS=5.0
