# MediaHub Nginx GATEWAY template (envsubst by the official nginx image:
# /etc/nginx/templates/*.template → /etc/nginx/conf.d/*.conf at start).
#
# This container IS the app gateway (2026-07-06): the Synology reverse proxy
# forwards cn.nous.ink:88 → :8881 (this container), which
# path-routes:
#   /f/       signed direct file serve (secure_link) — bytes off disk
#   /stream/  HLS segments — bytes off disk
#   /health   gateway health
#   /         everything else proxied to the backend (API/WS/SSE)
# ${NGINX_SECURE_LINK_SECRET} comes from the container env. Watchtower does
# NOT apply compose changes — see docs/runbook/nginx-direct-serve.md.

# WebSocket upgrade mapping (conf.d files live inside the http block).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;

    # HLS streaming - serve video segments and playlists
    location /stream/ {
        alias /app/downloads/;

        types {
            application/vnd.apple.mpegurl m3u8;
            video/mp2t ts;
            video/mp4 m4s mp4;
        }

        # Cache: segments are immutable, playlists need short cache
        set $cache_control "public, max-age=31536000";
        if ($request_filename ~* \.m3u8$) {
            set $cache_control "public, max-age=2";
        }
        add_header Cache-Control $cache_control;

        # Allow cross-origin requests from frontend
        add_header Access-Control-Allow-Origin *;
        add_header Access-Control-Allow-Methods "GET, OPTIONS";
        add_header Access-Control-Allow-Headers "Range, Origin, Accept, Authorization";

        # Handle preflight requests
        if ($request_method = 'OPTIONS') {
            add_header Access-Control-Allow-Origin *;
            add_header Access-Control-Allow-Methods "GET, OPTIONS";
            add_header Access-Control-Allow-Headers "Range, Origin, Accept, Authorization";
            add_header Content-Length 0;
            add_header Content-Type text/plain;
            return 204;
        }
    }

    # Signed direct file serve (million-files P3) — FastAPI answers cover/
    # file requests with a 302 here; bytes go straight from disk via
    # sendfile. Signature formula must match backend
    # app/services/media/nginx_direct.py sign_direct_url EXACTLY.
    location /f/ {
        alias /app/downloads/;

        secure_link $arg_st,$arg_e;
        secure_link_md5 "$secure_link_expires$uri ${NGINX_SECURE_LINK_SECRET}";

        if ($secure_link = "") { return 403; }
        if ($secure_link = "0") { return 410; }

        add_header Cache-Control "private, max-age=86400";
        add_header Access-Control-Allow-Origin *;
    }

    # Health check
    location /health {
        return 200 'OK';
        add_header Content-Type text/plain;
    }

    # ── Everything else → backend (API / WebSocket / SSE) ─────────────
    # The backend caps uploads at 500 MB; match it here or nginx 413s
    # bulk imports before FastAPI ever sees them.
    client_max_body_size 512m;

    location / {
        # Runtime DNS resolution (2026-07-11 outage fix): a literal
        # proxy_pass hostname is resolved ONCE at nginx startup and cached
        # forever. When Watchtower recreates the backend, its old IP can be
        # re-assigned to the worker container, silently routing /api into a
        # container that only serves probe routes — business routes 404 for
        # hours while every healthcheck stays green. The variable form of
        # proxy_pass forces per-request resolution against Docker's embedded
        # DNS (127.0.0.11), re-capped every 10s. No URI part in the variable,
        # so the original request URI is passed through unchanged (same
        # semantics as the literal form had).
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $mediahub_upstream http://mediahub:8080;
        proxy_pass $mediahub_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # WebSocket (/api/v1/ws/*) + SSE (chat streaming): upgrade passthrough,
        # no buffering (SSE events must flush per-event), long timeouts for
        # ws/sse/large transfers.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Gzip for playlists (m3u8 are text-based)
    gzip on;
    gzip_types application/vnd.apple.mpegurl;
    gzip_min_length 256;
}
