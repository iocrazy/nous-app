# nous GPU-stack Nginx GATEWAY template (envsubst by the official nginx
# image: /etc/nginx/templates/*.template → /etc/nginx/conf.d/*.conf at start).
#
# nas-A forwards cn.nous.ink:88 → 10.0.0.10:8080, which is THIS container
# (backend sits on host port 8890 as the debug door):
#   /health   gateway health
#   /         everything else proxied to nous-backend (API / WS / SSE)
# 2026-09-07: the signed direct file serve (/f/, million-files P3) is gone —
# every media row lives in the object store, so nginx has no disk to serve.
# NOTE: /stream/ is deliberately NOT direct-served here (unlike the NAS-era
# gateway) — the gpupc stack has been serving streams through FastAPI since
# 2026-07-25 and HLS is moving to object storage (#1575); adding it back is
# a separate decision.

# WebSocket upgrade mapping (conf.d files live inside the http block).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;

    # Health check
    location /health {
        return 200 'OK';
        add_header Content-Type text/plain;
    }

    # ── Everything else → backend (API / WebSocket / SSE) ─────────────
    # The backend caps uploads at 500 MB; match it here or nginx 413s
    # bulk imports before FastAPI ever sees them.
    client_max_body_size 512m;

    location / {
        # Runtime DNS resolution (2026-07-11 outage fix): a literal
        # proxy_pass hostname is resolved ONCE at nginx startup and cached
        # forever. When the backend container is recreated, its old IP can
        # be re-assigned to another container, silently routing /api into a
        # container that only serves probe routes — business routes 404 for
        # hours while every healthcheck stays green. The variable form of
        # proxy_pass forces per-request resolution against Docker's embedded
        # DNS (127.0.0.11), re-capped every 10s. No URI part in the variable,
        # so the original request URI is passed through unchanged.
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $nous_upstream http://nous-backend:8080;
        proxy_pass $nous_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # WebSocket (/api/v1/ws/*) + SSE (chat streaming): upgrade passthrough,
        # no buffering (SSE events must flush per-event), long timeouts for
        # ws/sse/large transfers.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
