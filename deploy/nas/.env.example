# NAS prod .env shape (real values live ONLY in /volume1/docker/mediahub/docker/.env on NAS).
#
# This is a tracked-in-git mirror of the env *keys* the deployed compose
# expects, so a recovery from scratch knows what to populate. Do NOT
# commit real values here. The secret store of record is the NAS host
# .env file, with backups in /volume1/docker/mediahub/docker/.env.bak-*.
#
# To regenerate this file from current NAS state:
#   ssh nas 'sudo grep -E "^[A-Z_]+=" /volume1/docker/mediahub/docker/.env \
#     | sed "s/=.*$/=<value>/"' > deploy/nas/.env.example

# ── Supabase (self-hosted prod stack at mediahub-sb-prod-*) ──
SUPABASE_URL=<value>
SUPABASE_ANON_KEY=<value>
SUPABASE_SERVICE_ROLE_KEY=<value>
SUPABASE_TENANT_ID=<value>

# ── Server config ──
HOST=<value>          # 0.0.0.0
APP_PORT=<value>      # 8880 — host-side; container internal stays 8080
FLOWER_PORT=<value>   # legacy Celery monitor — unused since DBOS migration
REDIS_PORT=<value>    # 6380 — host-side; container internal stays 6379
RELOAD=<value>        # false in prod
COOKIES_DIR=<value>
DOWNLOAD_HOST_PATH=<value>  # /volume2/sources/MediaHub.library

# ── Optional integrations ──
PUSH_TO_NOTION=<value>
NOTION_API_KEY=<value>
NOTION_DATABASE_ID=<value>

# ── Internal URLs (computed) ──
REDIS_URL=<value>
SSRF_DNS_TIMEOUT_SECONDS=<value>

# ── DBOS direct PG (NOT supavisor — DBOS uses LISTEN/NOTIFY) ──
# Format: postgresql://postgres.{tenant_id}:{password}@{host}:{port}/postgres
DBOS_DATABASE_URL=<value>
